# Create a file named .env in the mobile folder.
# Open your terminal, run 'ipconfig' (Windows) or 'ifconfig' (Mac).
# Find your IPv4 Address and replace the IP/port below with your own.

# Expo Environment: web-local | android-emulator | physical-device
EXPO_PUBLIC_ENVIRONMENT=web-local

# Your computer's local IP address (only needed for physical-device, e.g., 192.168.1.45)
EXPO_PUBLIC_COMP_IP=192.168.1.XX

# The API base URL. Takes priority over ENVIRONMENT and COMP_IP if defined.
# Note: Backend server by default runs on port 5000.
EXPO_PUBLIC_API_URL=http://localhost:5000/api